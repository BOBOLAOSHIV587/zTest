[Script]
raw-github-preview = type=http-response, pattern=^https:\/\/(raw|gist)\.githubusercontent\.com\/.*, script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/zTest/refs/heads/main/TORBrowser/JS/TORBrowser.js, requires-body=false, timeout=10

[MITM]
hostname = %APPEND% raw.githubusercontent.com, gist.githubusercontent.com

