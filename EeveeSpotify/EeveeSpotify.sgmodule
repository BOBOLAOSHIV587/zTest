#!name=Spotify Eevee Real Network Patch
#!desc=Generated from EeveeSpotify.dylib real strings and symbols

[Rule]
DOMAIN,sponsor.ajay.app,REJECT
DOMAIN-SUFFIX,lrclib.net,DIRECT
DOMAIN-SUFFIX,musixmatch.com,DIRECT
DOMAIN-SUFFIX,genius.com,DIRECT
DOMAIN-SUFFIX,spicylyrics.org,DIRECT
DOMAIN-SUFFIX,petitlyrics.com,DIRECT

[Script]
# Premium / Upsell flags
http-response ^https:\/\/(api\.spotify\.com|xpui\.app\.spotify\.com)\/.* script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/zTest/refs/heads/main/EeveeSpotify/JS/SpotifyPremium.js,requires-body=true

# Ads feature flags
http-response ^https:\/\/(api\.spotify\.com|xpui\.app\.spotify\.com)\/.* script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/zTest/refs/heads/main/EeveeSpotify/JS/SpotifyAds.js,requires-body=true

# Spotify access token capture
http-response ^https:\/\/accounts\.spotify\.com\/.* script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/zTest/refs/heads/main/EeveeSpotify/JS/SpotifyToken.js,requires-body=true

# Lyrics providers
http-response ^https:\/\/(api\.genius\.com|api\.spicylyrics\.org|apic\.musixmatch\.com|lrclib\.net|p1\.petitlyrics\.com)\/.* script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/zTest/refs/heads/main/EeveeSpotify/JS/SpotifyLyrics.js,requires-body=true

[MITM]
hostname = %APPEND% api.spotify.com, xpui.app.spotify.com, accounts.spotify.com, api.genius.com, api.spicylyrics.org, apic.musixmatch.com, lrclib.net, p1.petitlyrics.com
