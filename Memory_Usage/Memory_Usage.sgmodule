#!name=Surge Monitor
#!desc=实时监控 Surge 内存占用、运行时间及流量统计。

[Panel]
# 直接填写你的密码（例如你的密码是 123456，则写 argument=123456）
Surge-Monitor = script-name=surge-monitor, update-interval=5, argument=123

[Script]
surge-monitor = type=generic, script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/zTest/main/Memory_Usage/JS/Memory_Usage.js, timeout=10
